# Copy to backend-java/.env (git-ignored) and replace the placeholders, or export these
# variables in your shell / IDE run configuration instead.
# Values are read as Java properties: no quotes, no "export".

# Neon console -> your project -> Connect -> turn on "Connection pooling".
# Neon shows  postgresql://ROLE:PASSWORD@HOST/DATABASE?sslmode=require
# Rewrite it as a JDBC URL without the credentials:
#             jdbc:postgresql://HOST/DATABASE?sslmode=require
# The pooled host contains "-pooler".
SILENTVOIX_DATABASE_URL=jdbc:postgresql://ep-your-endpoint-id-pooler.your-region.aws.neon.tech/your_database?sslmode=require
SILENTVOIX_DATABASE_USERNAME=your_neon_role
SILENTVOIX_DATABASE_PASSWORD=your_neon_password

# Optional
# SILENTVOIX_DATABASE_POOL_SIZE=5
# PORT=8081
